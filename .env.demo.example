# Safe local-only demo profile. Copy to .env.demo locally; never commit the copy.
ENVIRONMENT=local
API_HOST_PORT=8000
WEB_HOST_PORT=3000
MCP_HOST_PORT=8010
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
PROMETHEUS_HOST_PORT=9090
TEMPO_HOST_PORT=3200
GRAFANA_HOST_PORT=3001
OBSERVABILITY_ENABLED=true
PROMETHEUS_METRICS_ENABLED=true
OTEL_TRACE_SAMPLE_RATIO=1.0
IDENTITY_LEGACY_HEADERS_ENABLED=false
CREWAI_EXECUTION_MODE=temporal
CREWAI_TRACING_ENABLED=true
CREWAI_DISABLE_TELEMETRY=true
CREWAI_DISABLE_TRACKING=true
TEMPORAL_ENABLED=true
TEMPORAL_DEV_FAULT_STAGE=
TEMPORAL_DEV_FAULT_CATEGORY=
CREWAI_OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
