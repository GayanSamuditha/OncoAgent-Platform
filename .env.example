APP_NAME=OncoAgent Platform API
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://oncoagent:oncoagent_dev@localhost:5432/oncoagent
POSTGRES_DB=oncoagent
POSTGRES_USER=oncoagent
POSTGRES_PASSWORD=oncoagent_dev
POSTGRES_HOST_PORT=55432
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CLINICAL_EMBEDDING_MODEL=emilyalsentzer/Bio_ClinicalBERT
CLINICAL_EMBEDDING_MODEL_REVISION=main
EMBEDDING_DEVICE=auto
EMBEDDING_MAX_SEQUENCE_LENGTH=256
EMBEDDING_TOKEN_OVERLAP=32
EMBEDDING_BATCH_SIZE_MPS=8
EMBEDDING_BATCH_SIZE_CPU=4
RETRIEVAL_PROFILE=medcpt
MEDCPT_QUERY_MODEL=ncbi/MedCPT-Query-Encoder
MEDCPT_DOCUMENT_MODEL=ncbi/MedCPT-Article-Encoder
MEDCPT_QUERY_REVISION=main
MEDCPT_DOCUMENT_REVISION=main
RETRIEVAL_QUERY_MAX_LENGTH=64
RETRIEVAL_DOCUMENT_MAX_LENGTH=512
RERANKER_MODEL=ncbi/MedCPT-Cross-Encoder
RERANKER_MODEL_REVISION=main
RERANKER_BATCH_SIZE=4
RRF_CONSTANT=60
AGENT_EXECUTION_ENABLED=true
WORKFLOW_MAX_CANDIDATES=50
WORKFLOW_TOOL_TIMEOUT_SECONDS=10
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_TIMEOUT_SECONDS=60
LOCAL_LLM_MAX_RETRIES=1
LOCAL_LLM_TEMPERATURE=0
LOCAL_LLM_CONTEXT_LENGTH=8192
LOCAL_LLM_MAX_OUTPUT_TOKENS=1024
LOCAL_LLM_KEEP_ALIVE=5m
LOCAL_LLM_THINKING=false
LOCAL_LLM_REQUIRE_STRUCTURED_OUTPUT=true
LOCAL_LLM_MAX_RESPONSE_BYTES=1048576
PLANNER_DEFAULT_PROVIDER=qwen_local
PLANNER_FALLBACK_PROVIDER=deterministic
